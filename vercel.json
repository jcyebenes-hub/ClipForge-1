{
  "crons": [
    {
      "path": "/api/cron/vigilar-canal",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/publicar",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}
