# ==============================================================================
# CLIPFORGE - VARIABLES DE ENTORNO PARA PRODUCCIÓN (.env.local / Vercel Env Vars)
# ==============================================================================

# 1. Supabase (Base de datos PostgreSQL, Auth & Storage)
# Obtén estos valores en tu dashboard de Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada-aqui

# 2. Inteligencia Artificial (Groq & Google Gemini)
# Groq: Whisper Large v3 Turbo (transcripciones rápidas) y Llama 3.3 70B (análisis viral y ganchos)
GROQ_API_KEY=gsk_tu_clave_groq_aqui
GEMINI_API_KEY=tu_clave_gemini_aqui

# 3. Microservicio de Descarga YouTube (FastAPI + yt-dlp en Render / Railway / VPS)
# URL pública HTTPS de tu worker desplegado (ej. https://clipforge-worker.onrender.com)
YT_WORKER_URL=https://clipforge-worker.onrender.com

# 4. YouTube Data API v3 & Google OAuth 2.0 (Publicación automática en Shorts)
# Consola de Google Cloud -> Credenciales OAuth 2.0 (Aplicación web)
# URI de redirección autorizada: https://tu-dominio.vercel.app/api/youtube/callback
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
YOUTUBE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=tu-google-client-secret
OAUTH_ENCRYPTION_SECRET=clave-secreta-32-caracteres-para-cifrado-aes256

# 5. Seguridad de Crons y Dominio de la App
# Token secreto para proteger las rutas /api/cron/*
CRON_SECRET=clave-super-secreta-para-crons
APP_URL=https://tu-dominio.vercel.app
